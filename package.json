{
  "name": "chadvue",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/chadvue.js"
    }
  },
  "scripts": {
    "typecheck": "vue-tsc --noEmit",
    "build": "npm run typecheck && vite build && vue-tsc -p tsconfig.build.json",
    "storybook": "storybook dev -p 6006 --no-open --disable-telemetry",
    "build-storybook": "storybook build --disable-telemetry",
    "check:contrast": "node scripts/check-contrast.mjs"
  },
  "peerDependencies": {
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@storybook/addon-docs": "10.6.6",
    "@storybook/vue3-vite": "10.6.6",
    "@types/node": "24.19.2",
    "@vitejs/plugin-vue": "6.0.10",
    "storybook": "10.6.6",
    "typescript": "6.0.3",
    "vite": "8.3.6",
    "vue": "3.5.45",
    "vue-component-meta": "3.3.14",
    "vue-tsc": "3.3.14"
  },
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": ">=24.22.2 <25",
    "npm": ">=11.19.1 <12"
  }
}
