{
  "name": "chadvue",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/chadvue.js"
    },
    "./style.css": "./dist/chadvue.css"
  },
  "scripts": {
    "typecheck": "vue-tsc --noEmit",
    "build": "npm run typecheck && vite build && vue-tsc -p tsconfig.build.json",
    "storybook": "storybook dev -p 6006 --no-open --disable-telemetry",
    "build-storybook": "storybook build --disable-telemetry",
    "check:contrast": "node scripts/check-contrast.mjs",
    "test": "vitest run",
    "test:browser": "npm run build-storybook && playwright test",
    "check": "npm run check:docs && npm run check:contrast && npm test && npm run build",
    "check:package": "npm run build && tsc -p tests/consumer/tsconfig.json && node scripts/check-package.mjs",
    "check:docs": "node scripts/check-docs.mjs"
  },
  "peerDependencies": {
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@storybook/addon-docs": "10.6.6",
    "@storybook/vue3-vite": "10.6.6",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "24.19.2",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.4.11",
    "axe-core": "4.14.0",
    "jsdom": "31.0.1",
    "storybook": "10.6.6",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vite": "8.3.6",
    "vitest": "5.1.0",
    "vue": "3.5.45",
    "vue-component-meta": "3.3.14",
    "vue-tsc": "3.3.14"
  },
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": ">=24.22.2 <25",
    "npm": ">=11.19.1 <12"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "overrides": {
    "js-beautify": {
      "glob": "14.0.6",
      "editorconfig": "4.0.1"
    }
  },
  "dependencies": {
    "@lucide/vue": "1.73.0"
  }
}
